                    pici: WfForm.getFieldValue("field18871_" + rowIndex) || "", // 批次号
                    SN: WfForm.getFieldValue("field18855_" + rowIndex) || "0",  //SN起始码
                    byte0_3: byte0_3 // 添加申请日期到记录中
                   
                };
                
                // 只添加有产品代码和批次号的记录
                if (record.cpxh && record.pici) {
                    detailRecords.push(record);
                }
                if(record.cpxh.length===0 || record.pici.length===0){
                   alert(record.cpxh);
                    console.log("record.cpxh的值"+record.cpxh);
                   return;
                }
            }
        }
        
        if (detailRecords.length === 0) {
            alert('请至少填写一条包含产品代码和批次号的明细记录');
            return;
        }
        
          console.log("record.cpxh的值"+record.cpxh);
        // 按产品代码分组
        var groupedRecords = {};
        for (var i = 0; i < detailRecords.length; i++) {
            var record = detailRecords[i];
             // 确保使用原始项目号，不进行任何处理
             var productCode = String(record.cpxh).trim(); // 转换为字符串并去除空格
            if (!groupedRecords[productCode]) {
                groupedRecords[productCode] = [];
            }
            
            groupedRecords[productCode].push(record);
        }
        
