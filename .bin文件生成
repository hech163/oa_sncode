// 为特定产品代码生成ZIP文件
async function generateZipForProduct(productCode, records) {
    var zip = new JSZip();
    var firstFolder = productCode + 'CODE';
    var productFolder = zip.folder(firstFolder);
     console.log("record.firstFolder的值"+firstFolder);
    // 为每个记录生成BIN文件
    for (var i = 0; i < records.length; i++) {
        var record = records[i];
        var binContent = generateSingleBinFile(record);
        var serialFolder = productFolder.folder(record.pici);
        var fileName = record.cpxh + '_SN.bin';
        serialFolder.file(fileName, binContent);
    }
    
    // 生成ZIP文件并触发下载
    var content = await zip.generateAsync({type: "blob"});
    var downloadUrl = URL.createObjectURL(content);
    
    var a = document.createElement('a');
    a.href = downloadUrl;
    a.download = firstFolder + '.zip';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    
    URL.revokeObjectURL(downloadUrl);
}
// 根据明细记录生成单个BIN文件内容
function generateSingleBinFile(record) {
    // 创建256字节的ArrayBuffer，初始填充0xFF
    const buffer = new ArrayBuffer(256);
    const view = new DataView(buffer);
    for (let i = 0; i < 256; i++) {
        view.setUint8(i, 0xFF);
    }
    // 0-3字节: 日期处理 (byte0_3)
     console.log("record.byte0_3的值"+record.byte0_3);
      console.log("record.byte0_3.length的值"+record.byte0_3.length);
    if (record.byte0_3 && record.byte0_3.length === 8) {
        view.setUint8(0, parseInt(record.byte0_3.substring(0, 2), 16)); // 年的后两位
        view.setUint8(1, parseInt(record.byte0_3.substring(2, 4), 16)); // 年的前两位
        view.setUint8(2, parseInt(record.byte0_3.substring(4, 6), 16)); // 月
        view.setUint8(3, parseInt(record.byte0_3.substring(6, 8), 16)); // 日
    }
    // 4-6字节: 产品代码处理 (cpxh)
    const numbers = record.cpxh ? record.cpxh.replace(/\D/g, '') : '';
    if (numbers.length >= 4) {
        view.setUint8(4, parseInt(numbers.substring(0, 2), 16));
        view.setUint8(5, parseInt(numbers.substring(2, 4), 16));
    }
    view.setUint8(6, 0xFF);
    // 7-10字节: 固定00 00 00 00
    for (let i = 7; i <= 10; i++) {
        view.setUint8(i, 0x00);
    }
    // 11-13字节: byte11, byte12, byte13
    view.setUint8(11, parseInt(record.byte11, 16) || 0);
    view.setUint8(12, parseInt(record.byte12, 16) || 0);
    view.setUint8(13, parseInt(record.byte13, 16) || 0);
    // 14-15字节: 固定55 55
    view.setUint8(14, 0x55);
    view.setUint8(15, 0x55);
    // 16字节: pici长度
    view.setUint8(16, record.pici ? record.pici.length : 0);
    // 17字节: 固定01
    view.setUint8(17, 0x01);
    // 18-19字节: 固定AA AA
    view.setUint8(18, 0xAA);
    view.setUint8(19, 0xAA);
    // 20-31字节: pici转换
    const txt7Bytes = castToRaw(record.pici || "");
    for (let i = 0; i < 12; i++) {
        view.setUint8(20 + i, txt7Bytes[i]);
    }
    // 32-35字节: SN码计算
    const txt8Bytes = numberToHexBytesDataView(parseInt(record.SN) || 0);
    for (let i = 0; i < 4; i++) {
        view.setUint8(32 + i, txt8Bytes[i]);
    }
    // 36-249字节: 已初始化为0xFF
    // 250字节: 0xF0 + year % 10 (基于byte0_3)
    if (record.byte0_3 && record.byte0_3.length >= 4) {
        const year = parseInt(record.byte0_3.substring(0, 4)); // 提取年份
        const yearLastDigit = year % 10; // 年份的最后一位
        view.setUint8(250, 0xF0 + yearLastDigit);
    } else {
        view.setUint8(250, 0xF0); // 默认值
    }
  // 251字节: 周数计算 (基于byte0_3)
    // 计算周数并减1
    const weekNum = getWeekNumber(record.byte0_3 || "");
    const weekValue = weekNum - 1;
    
    // 将周数值转换为十六进制字符串
    const weekHex = weekValue.toString(16).toUpperCase().padStart(2, '0');
    
    // 将这个十六进制字符串解析为数值存储
    // 例如：weekValue = 42, weekHex = "2A", 但这不是我们想要的
    // 我们想要存储的是十六进制值0x42（即十进制66）
    
    // 所以我们需要将周数值作为十六进制数字的字符串表示来处理
    // 例如：周数42 -> 字符串"42" -> 解析为十六进制数0x42（十进制66）
    const weekHexDisplay = weekValue.toString().padStart(2, '0'); // 确保是两位数字符串
    const byteValue = parseInt(weekHexDisplay, 16); // 将"42"解析为十六进制数
    
    view.setUint8(251, byteValue);
    // 252-255字节: 前0-251字节的CRC32值
    // 提取前252字节数据
    const dataForCRC = new Uint8Array(buffer, 0, 252);
    const crcValue = crc32b(dataForCRC);
    
    // 以大端序写入CRC32值
    view.setUint32(252, crcValue, false);
    return buffer;
}
// 计算周数函数
function getWeekNumber(dateStr) {
    if (!dateStr || dateStr.length !== 8) return 43; // 默认43周
    
    const year = parseInt(dateStr.substring(0, 4));
    const month = parseInt(dateStr.substring(4, 6)) - 1;
    const day = parseInt(dateStr.substring(6, 8));
    
    const date = new Date(year, month, day);
    const firstDayOfYear = new Date(date.getFullYear(), 0, 1);
    const pastDaysOfYear = (date - firstDayOfYear) / 86400000;
    
    return Math.ceil((pastDaysOfYear + firstDayOfYear.getDay() + 1) / 7);
}
// 字符串转原始字节数组
function castToRaw(str) {
    if (!str) return new Array(12).fill(0xFF);
    
    const result = [];
    for (let i = 0; i < Math.min(str.length, 12); i++) {
        result.push(str.charCodeAt(i));
    }
    
    // 填充剩余字节
    while (result.length < 12) {
        result.push(0xFF);
    }
    
    return result;
}
// 数字转十六进制字节
function numberToHexBytesDataView(num) {
    const value = num || 0;
    const buffer = new ArrayBuffer(4);
    const view = new DataView(buffer);
    view.setUint32(0, value, false); // 大端序
    return new Uint8Array(buffer);
}
// CRC32计算函数
function crc32b(data) {
  let crc = 0xFFFFFFFF;
  const table = [];
  
  // 预计算CRC表
  for (let i = 0; i < 256; i++) {
    let c = i;
    for (let j = 0; j < 8; j++) {
      if (c & 1) {
        c = 0xEDB88320 ^ (c >>> 1);
      } else {
        c = c >>> 1;
      }
    }
    table[i] = c;
  }
  
  // 计算CRC
  for (let i = 0; i < data.length; i++) {
    crc = table[(crc ^ data[i]) & 0xFF] ^ (crc >>> 8);
  }
  
  return crc ^ 0xFFFFFFFF;
}
function calculateDetailRows() {
    // 获取明细表所有行索引
    var rowArr = WfForm.getDetailAllRowIndexStr("detail_1").split(",");
    
    // 用于存储每个txt2对应的基数信息和当前计数
    var baseDataMap = {};
    
    // 第一次遍历：收集每个txt2的基数信息
    for(var i = 0; i < rowArr.length; i++) {
        var rowIndex = rowArr[i];
        if(rowIndex !== "") {
            
            var cpxhValue = WfForm.getFieldValue("field18854_" + rowIndex); //获取当前行产品型号
            var baseValue = WfForm.getFieldValue("field18869_" + rowIndex);//获取SN基数
            
            if(cpxhValue && baseValue) {
                // 如果该txt2值还没有记录，初始化
                if(!baseDataMap[cpxhValue]) {
                    baseDataMap[cpxhValue] = {
                        base: parseFloat(baseValue), // 基数
                        currentStart: null,          // 当前起始位
                        rows: []                     // 该分组的所有行索引
                    };
                }
                // 将该行添加到对应分组中
                baseDataMap[cpxhValue].rows.push(rowIndex);
            }
        }
    }
    
    // 第二次遍历：计算每个分组的起始位和结束位
    for(var cpxhValue in baseDataMap) {
        if(baseDataMap.hasOwnProperty(cpxhValue)) {
            var groupData = baseDataMap[cpxhValue];
            var base = groupData.base;
            var rows = groupData.rows;
            
            // 按行索引排序，确保按顺序计算
            rows.sort(function(a, b) {
                return parseInt(a) - parseInt(b);
            });
            
            // 遍历该分组的所有行
            for(var j = 0; j < rows.length; j++) {
                var rowIndex = rows[j];
                var currentStart = WfForm.getFieldValue("field18855_" + rowIndex);
                
                // 如果是该分组的第一行且起始位已填写
                if(j === 0 && currentStart) {
                    var startNum = parseFloat(currentStart);
                    var endNum = startNum + base - 1;
                    
                    // 更新结束位
                    WfForm.changeFieldValue("field18856_" + rowIndex, {value: endNum.toString()});
                    
                    // 记录下一行的起始位
                    groupData.currentStart = endNum + 1;
                }
                // 如果是后续行
                else if(j > 0 && groupData.currentStart !== null) {
                    var startNum = groupData.currentStart;
                    var endNum = startNum + base - 1;
                    
                    // 更新起始位和结束位
                    WfForm.changeFieldValue("field18855_" + rowIndex, {value: startNum.toString()});
                    WfForm.changeFieldValue("field18856_" + rowIndex, {value: endNum.toString()});
                    
                    // 更新下一行的起始位
                    groupData.currentStart = endNum + 1;
                }
            }
        }
    }
}
function formatDateToYYYYMMDD(dateStr) {
    if (!dateStr) return "";
    
    // 移除所有非数字字符，只保留数字
    const numbers = dateStr.replace(/\D/g, '');
    
    // 如果已经是8位数字，直接返回
    if (numbers.length === 8) {
        return numbers;
    }
    
    // 尝试解析标准日期格式
    const date = new Date(dateStr);
    if (!isNaN(date.getTime())) {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        return `${year}${month}${day}`;
    }
    
    // 如果无法解析，返回空字符串
    return "";
}
