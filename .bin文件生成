                    测试程序: testProgram.cslb + ":" + testProgram.cscx,
                    备注: testProgram.wdDisplay // 使用显示值
                });
                
                totalCombinations++;
                console.log("已添加组合数据: " + material.lh + ", " + material.tc_sfd06 + ", " + 
                           material.cgsl + ", " + material.ph + ", " + 
                           testProgram.cslb + ":" + testProgram.cscx + ", " + testProgram.wd);
            }
        } else {
            console.log("料号 " + materialCode + " 在测试程序表中没有对应的测试程序数据");
        }
    }
    
    console.log("组合完成！共生成 " + totalCombinations + " 行数据");
} else {
    console.log("料号批次表无数据，无法进行组合");
}
} 
// 从明细表1获取数据并写入明细表4
function updateDetail4FromDetail1() {
    // 获取明细表1所有行索引
    var detail1Rows4 = WfForm.getDetailAllRowIndexStr("detail_1").split(",");
    // 用于存储每个项目号的最大SN结束号
    var projectMaxSN = {};
    
    // 遍历明细表1，找出每个项目号的最大SN结束号
    for(var i = 0; i < detail1Rows4.length; i++) {
        var rowIndex = detail1Rows4[i];
        if(rowIndex !== "") {
            // 获取当前行的项目号和SN结束号
            var projectNo = WfForm.getFieldValue("field18854_" + rowIndex); // 项目号
            var snEnd = WfForm.getFieldValue("field18856_" + rowIndex); // SN结束号
            
            if(projectNo && snEnd) {
                var snEndNum = parseFloat(snEnd);
                
                // 如果该项目号还没有记录，或者当前SN结束号更大，则更新
                if(!projectMaxSN[projectNo] || snEndNum > projectMaxSN[projectNo]) {
                    projectMaxSN[projectNo] = snEndNum;
                }
            }
        }
    }
    
    // 清空明细表4
    WfForm.delDetailRow("detail_4", "all");
    // 遍历projectMaxSN，为每个项目号在明细表4中创建新行
    var projectKeys = Object.keys(projectMaxSN);
    for(var j = 0; j < projectKeys.length; j++) {
        var projectNo = projectKeys[j];
        var maxSN = projectMaxSN[projectNo];
        console.log("projectNo: " + projectKeys[j]);
        console.log("maxSN: " + projectMaxSN[projectNo]);
        // 计算当前最大值 = 最大SN结束号 + 1
        var currentMax = (maxSN + 1).toString();
        
        // 在明细表4中添加新行并设置初始值
        WfForm.addDetailRow("detail_4", {
            field18930: {value: projectNo},    // 项目号
            field18942: {value: currentMax}    // 当前最大值
        });
    }
}
</script>
